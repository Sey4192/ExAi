{
  "expo": {
    "name": "Tymeout Practice",
    "slug": "tymeout-practice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.sey4192.tymeoutpractice",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#3E6B89",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-background-task",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#3E6B89" }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 200, "backgroundColor": "#3E6B89" }]
    ]
  }
}
